{
  "version": 1,
  "license": "All assets CC0 (Poly Haven). See CREDITS.md.",
  "conventions": {
    "normal_maps": "OpenGL / +Y up (Poly Haven nor_gl). Use as-is in three.js MeshStandardMaterial.normalMap; no flip.",
    "arm_maps": "glTF ORM layout: R = ambient occlusion, G = roughness, B = metalness (all ~0 here). Assign the same texture to aoMap (uses R), roughnessMap (uses G), metalnessMap (uses B); set metalness to 0.",
    "color_space": "albedo and sky_4k.jpg are sRGB; normal and arm maps are linear (NoColorSpace). env_1k.hdr is linear HDR.",
    "tiling": "All terrain sets are seamless; set wrapS/wrapT = RepeatWrapping. Real-world scale of each set is in world_size_m.",
    "format": "Terrain textures are WebP (lossy). Models use EXT_texture_webp (GLTFLoader supports it in r169)."
  },
  "sky": {
    "env_hdr": {
      "path": "sky/env_1k.hdr",
      "bytes": 1121338,
      "format": "Radiance RGBE equirectangular",
      "resolution": [
        1024,
        512
      ],
      "colorSpace": "linear (HDR)",
      "purpose": "PMREM image-based lighting. Load with RGBELoader (HalfFloat), mapping EquirectangularReflectionMapping, then PMREMGenerator.fromEquirectangular.",
      "source": "Poly Haven syferfontein_1d_clear_puresky 1k"
    },
    "backdrop_ldr": {
      "path": "sky/sky_4k.jpg",
      "bytes": 252253,
      "format": "JPEG q88 equirectangular",
      "resolution": [
        4096,
        2048
      ],
      "colorSpace": "sRGB",
      "purpose": "Visible backdrop. Same 4k HDR tone-mapped with three.js ACESFilmic at exposure 1.0 (including the /0.6 factor and the RRT/ODT fit) then sRGB-encoded, triangular-dithered to avoid banding. Use scene.background with colorSpace=SRGBColorSpace and a material/background that is NOT tone-mapped again (e.g. a sky sphere MeshBasicMaterial with toneMapped:false), or it will double tone-map.",
      "note": "The lower hemisphere is a mirror reflection of the sky (puresky convention), a bright blue-grey haze. Hide it under terrain/fog or clamp the sky sphere at the horizon."
    },
    "sun": {
      "measured_on": "4096x2048 HDR; brightest pixel (62851 cd/m2-ish linear luminance) and centroid of pixels above 50% of peak agree within 0.1 px",
      "azimuth_deg": 35.99,
      "elevation_deg": 0.94,
      "equirect_uv": [
        0.59997,
        0.5052
      ],
      "pixel_4k": [
        2457,
        1012
      ],
      "direction_to_sun_threejs": [
        0.80902,
        0.01634,
        0.58756
      ],
      "convention": "three.js equirect mapping with no backgroundRotation / environmentRotation: u = atan2(z,x)/(2*pi)+0.5, v = asin(y)/pi+0.5. azimuth_deg = (u-0.5)*360 measured from +X toward +Z; elevation_deg = (v-0.5)*180. direction_to_sun_threejs is the unit vector from the origin toward the sun in that convention: place the DirectionalLight at +direction*distance targeting the origin. To rotate the sky, apply the same Y rotation to the light direction.",
      "note": "The sun is almost on the horizon (0.94 deg), so it gives long warm raking light and a strong horizon glow. For a higher sun, rotate/raise the light but accept that the backdrop disc stays at the horizon."
    }
  },
  "sky_other_files": {
    "note": "Added by the code agent, not produced by this sourcing pass. sky/golden_env_1k.hdr is byte-identical to Poly Haven kloppenheim_06_puresky 1k (CC0, Greg Zaal / Jarod Guest); golden_sky_4k.jpg and golden_sky_fog.jpg are derived from it. src/main.js loads these, not env_1k.hdr / sky_4k.jpg. Its brightest 1k pixel is at about 5 deg elevation; the sun is hazy so measure it before aligning a light.",
